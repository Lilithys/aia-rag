          "parsed": {
            "units": [
              {
                "text": "补办非驾驶员身份证需根据情况选择方式。",
                "scope": "external_fact",
                "supported": true,
                "supporting_chunk_ids": [
                  "Replace a non-driver ID card#1_0::c0001"
                ],
                "reason": "The context states replacement is possible under certain conditions, implying method depends on situation."
              },
              {
                "text": "若证件丢失、损毁或地址变更，可申请更换；若已过期则需续期或新申请。",
                "scope": "external_fact",
                "supported": true,
                "supporting_chunk_ids": [
                  "Replace a non-driver ID card#1_0::c0001"
                ],
                "reason": "Directly supported by context c0001."
              },
              {
                "text": "若持有Standard证件，新证将显示“NOT FOR FEDERAL PURPOSES”，且不能寄往备用地址。",
                "scope": "external_fact",
                "supported": true,
                "supporting_chunk_ids": [
                  "Replace a non-driver ID card#1_0::c0004",
                  "Replace a non-driver ID card#1_0::c0005"
                ],
                "reason": "c0004 states online Standard replacement shows that phrase; c0005 states online orders cannot use alternate address."
              },
              {
                "text": "填写MV-44表格，附身份证明复印件及费用（支票或汇票，收款人为“Commissioner of Motor Vehicles”），寄至NYS Department of Motor Vehicles, 207 Genesee Street, Suite 6, Utica, NY 13501-2874。",
                "scope": "external_fact",
                "supported": true,
                "supporting_chunk_ids": [
                  "Replace a non-driver ID card#1_0::c0004"
                ],
                "reason": "Directly supported by c0004."
              },
              {
                "text": "若符合SSI资格，可申请减免费或免费，需提供SSI证明。",
                "scope": "external_fact",
                "supported": true,
                "supporting_chunk_ids": [
                  "Replace a non-driver ID card#1_0::c0004"
                ],
                "reason": "c0004 describes reduced fee or no fee with SSI proof."
              },
              {
                "text": "携带当前Standard非驾驶员ID、申请表及付款。",
                "scope": "external_fact",
                "supported": true,
                "supporting_chunk_ids": [
                  "Replace a non-driver ID card#1_0::c0005"
                ],
                "reason": "c0005 lists these items for office replacement."
              },
              {
                "text": "必须邮寄申请，附MV-44表格、身份证明复印件、费用，建议附预付费回邮信封。",
                "scope": "external_fact",
                "supported": true,
                "supporting_chunk_ids": [
                  "Replace a non-driver ID card#1_0::c0005"
                ],
                "reason": "c0005 states overseas must mail with these items and suggests prepaid envelope."
              },
              {
                "text": "需前往DMV办公室。",
                "scope": "external_fact",
                "supported": true,
                "supporting_chunk_ids": [
                  "Replace a non-driver ID card#1_0::c0005"
                ],
                "reason": "c0005 says name or other changes require visiting DMV office."
              },
              {
                "text": "若在生日后40天内下单，可避免“UNDER 21”标识。",
                "scope": "external_fact",
                "supported": true,
                "supporting_chunk_ids": [
                  "Replace a non-driver ID card#1_0::c0005"
                ],
                "reason": "c0005 states order within 40 days after birthday to avoid UNDER 21."
              },
              {
                "text": "新ID将在2周内邮寄至记录地址或备用地址。",
                "scope": "external_fact",
                "supported": true,
                "supporting_chunk_ids": [
                  "Replace a non-driver ID card#1_0::c0005"
                ],
                "reason": "c0005 says receive in 2 weeks and mail to record or alternate address."
              }
            ]
